{
  "name": "dsh-side-chat",
  "version": "1.2.1",
  "type": "module",
  "description": "A chat tab in the DeepSeek Harness right sidebar: a separate conversational thread that can read and search, but never changes anything.",
  "license": "MIT",
  "author": "Ivan Belyaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uzumaku13/DSH-side-chat-advisor.git"
  },
  "homepage": "https://github.com/Uzumaku13/DSH-side-chat-advisor#readme",
  "bugs": {
    "url": "https://github.com/Uzumaku13/DSH-side-chat-advisor/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chat",
    "agent-preset",
    "voice-input"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
